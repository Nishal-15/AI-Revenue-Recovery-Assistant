# Postgres connection string of the shared Supabase project (Settings > Database > Connection string).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Shared secret pg_cron / the frontend send as "Authorization: Bearer <token>" to trigger jobs.
ENGINE_API_TOKEN=change-me
# WhatsApp Cloud API (Meta). Leave WHATSAPP_ACCESS_TOKEN empty to run in dry-run mode (messages are logged, not sent).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# From Meta > WhatsApp > API Setup. Used by scripts/test_data.py; in production set it in the app's Settings.
WHATSAPP_PHONE_NUMBER_ID=
# Google Gemini: enquiry classification, message drafting, reply intent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Detection scan: run inside the engine every N minutes (or trigger POST /jobs/scan from pg_cron instead).
ENABLE_SCHEDULER=false
SCAN_INTERVAL_MINUTES=15
DB_POOL_MAX_SIZE=5
# Interactive API docs at http://localhost:8000/docs (keep false in production).
ENGINE_DOCS=true
# Your own WhatsApp number (E.164, e.g. +919876543210) for scripts/test_data.py. Leave empty in production.
TEST_WHATSAPP_NUMBER=
