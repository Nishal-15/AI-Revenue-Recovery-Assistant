{
  "name": "revenue-recovery",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dental-os/playground",
    "build": "npm run build -w @dental-os/revenue-recovery",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:test": "node tools/test-db.mjs",
    "deploy:demo": "npm run build -w @dental-os/playground && npx --prefix deploy/cloudflare/engine wrangler pages deploy apps/playground/dist --project-name revenue-recovery-demo",
    "deploy:engine": "npm run deploy --prefix deploy/cloudflare/engine",
    "db:setup-sql": "node tools/build-setup-sql.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19"
  }
}
