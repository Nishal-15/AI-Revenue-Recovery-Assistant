{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@dental-os/revenue-recovery/animation": ["../../packages/revenue-recovery/src/components/three/RecoveryFlow.tsx"],
      "@dental-os/revenue-recovery": ["../../packages/revenue-recovery/src/index.ts"]
    }
  },
  "include": ["src"]
}
