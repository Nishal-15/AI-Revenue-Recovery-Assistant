# From Supabase: Project Settings > API (or the green Connect button > App frameworks).
# Both values are safe to use in a website; the database password and service keys never go here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional: shown on the privacy and terms pages as the contact for data requests.
VITE_CONTACT_EMAIL=

# Optional: the product name shown across the website (default "Revenue Recovery").
VITE_BRAND_NAME=
